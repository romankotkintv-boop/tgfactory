# Скопируй в .env и заполни. Файл .env никому не отправляй (chmod 600).
DRY_RUN=1                      # 1 = ничего не публикуем, посты пишутся в outbox/. Боевой режим: 0
DB_PATH=factory.db
LOG_LEVEL=INFO

# Claude API: ключ на console.anthropic.com. Точные id моделей — там же, в разделе Models.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=                  # например id Claude Sonnet 5
CLAUDE_MODEL_CHEAP=            # например id Claude Haiku 4.5 (пока не используется)

# Картинки для РФ-канала (необязательно). Без ключа посты выходят без картинок.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1-mini

# Твой личный chat_id — сюда приходят посты на одобрение и ошибки. Узнать: написать @userinfobot
ADMIN_CHAT_ID=

# Боты (@BotFather) и каналы. Канал: @username или числовой id -100...
TG_BOT_RU=
TG_CHANNEL_RU=
TG_BOT_UZ=
TG_CHANNEL_UZ=
TG_BOT_BR=
TG_CHANNEL_BR=

# Shopee Affiliate Open API (Бразилия)
SHOPEE_APP_ID=
SHOPEE_SECRET=
